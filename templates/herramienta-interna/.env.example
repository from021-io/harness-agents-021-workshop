# Ejemplos: America/Mexico_City, America/Argentina/Buenos_Aires, Europe/Madrid
ZONA_HORARIA=

# ── Clave de acceso (solo al publicar en internet) ───────────
# Contraseña simple para que tu herramienta publicada no quede
# abierta a cualquiera. Se completa en el paso de publicar.
CLAVE_ACCESO=
