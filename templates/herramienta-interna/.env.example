# ── Modelo de IA ─────────────────────────────────────────────
# La llave la entrega quien da el taller. Es lo único que necesita
# esta herramienta para funcionar.
AI_GATEWAY_API_KEY=

# ── Zona horaria ─────────────────────────────────────────────
