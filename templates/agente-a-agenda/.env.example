# ── Modelo de IA ─────────────────────────────────────────────
# La llave la entrega el organizador del taller.
AI_GATEWAY_API_KEY=

# ── Telegram ─────────────────────────────────────────────────
# Se crean hablando con @BotFather en Telegram (el asistente te guía).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secreto inventado para validar los mensajes que llegan del webhook.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Tu chat personal con el bot. Lo completa solo el script conectar-telegram.
TELEGRAM_CHAT_ID=

# ── Google Calendar ──────────────────────────────────────────
# Estos dos los entrega el organizador del taller.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Este lo completa solo el script conectar-google (npm run conectar-google).
GOOGLE_REFRESH_TOKEN=

# --- Zona horaria ---
# La completa sola la preparacion, con la zona de tu computadora.
# Ejemplos: America/Mexico_City, America/Argentina/Buenos_Aires, Europe/Madrid
ZONA_HORARIA=
